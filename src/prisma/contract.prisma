model Todo {
id Int @id @default(autoincrement())
text String
completed Boolean @default(false)
}
model Forum {
id String @id @default(uuid())
name String
messages Message[]
}
model Message {
id Int @id @default(autoincrement())
text String
forum Forum @relation(fields: [forumid], references: [id])
forumid String
}
model User{
id  Int @id @default(autoincrement())
username String @unique
passwordHash String

}

model artikel{
    id  Int @id @default(autoincrement())
    name String
    price Int
}
model bid{
    id  Int @id @default(autoincrement())
    name String
    price Int
}